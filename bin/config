NGINX_VERSION='1.30.4'

root_dir="$(realpath -s "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/..")"
build_dir="$root_dir/build/nginx-$NGINX_VERSION"
run_dir="$root_dir/build/run-$NGINX_VERSION"

nginx_cmd="$build_dir/objs/nginx"

need_update() {
  src="$1"
  dst="$2"
  [[ ! -e "$dst" || "$src" -nt "$dst" ]]
}

# vim:set ft=bash:
